From: Oliver Lukschander <oliver.lukschander@golf.at>
Date: Sat, 20 Sep 2026 09:00:00 +0000
Subject: [PATCH] arm64: dts: apple: t600x: add m1n1 v1.6.1 USB4 aliases

m1n1 v1.6.1 copies ACIO tunables and the USB4 DROM using aliases named
usb4_%d_rc and usb4_%d_nhi (underscores). The DT only provided
usb4-%d-acio (hyphens). On that m1n1 the tunable copy is skipped, so
thunderbolt-apple-acio fails with "Unable to load rc tunable" and the
Type-C ports that wait on ACIO never come up.

Newer m1n1 falls back to the hyphen names. Ship both so v1.6.1 and
current m1n1 work. t602x J414/J416 include this file.

Tested on MacBook Pro 16-inch M2 Pro (apple,j416s).

Signed-off-by: Oliver Lukschander <oliver.lukschander@golf.at>
---
 arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi b/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
--- a/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
+++ b/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
@@ -34,16 +34,28 @@
  		usb4-0-acio = &usb4_0_acio;
 		usb4-0-nhi = &usb4_0_nhi;
 		usb4-0-pcie-adapter = &usb4_0_acio;
 		usb4-0-pcie = &apciec0;
+		usb4_0_rc = &usb4_0_acio;
+		usb4_0_nhi = &usb4_0_nhi;
+		usb4_0_pcie_adapter = &usb4_0_acio;
+		usb4_0_pcie = &apciec0;
 		usb4-1-acio = &usb4_1_acio;
 		usb4-1-nhi = &usb4_1_nhi;
 		usb4-1-pcie-adapter = &usb4_1_acio;
 		usb4-1-pcie = &apciec1;
+		usb4_1_rc = &usb4_1_acio;
+		usb4_1_nhi = &usb4_1_nhi;
+		usb4_1_pcie_adapter = &usb4_1_acio;
+		usb4_1_pcie = &apciec1;
 		usb4-2-acio = &usb4_2_acio;
 		usb4-2-nhi = &usb4_2_nhi;
 		usb4-2-pcie-adapter = &usb4_2_acio;
 		usb4-2-pcie = &apciec2;
+		usb4_2_rc = &usb4_2_acio;
+		usb4_2_nhi = &usb4_2_nhi;
+		usb4_2_pcie_adapter = &usb4_2_acio;
+		usb4_2_pcie = &apciec2;
 		usb4-3-pcie = &apciec3;
 		wifi0 = &wifi0;
 	};
-- 
